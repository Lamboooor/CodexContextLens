{
  "name": "codex-context-lens",
  "displayName": "Codex Context Lens",
  "description": "Local Codex token usage, context insights and quota snapshots in VS Code.",
  "version": "0.8.0",
  "publisher": "ruoyu-li",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codexContextLens.open",
        "title": "%command.open%"
      },
      {
        "command": "codexContextLens.select",
        "title": "%command.select%"
      },
      {
        "command": "codexContextLens.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "codexContextLens.settings",
        "title": "%command.settings%"
      },
      {
        "command": "codexContextLens.sidebar",
        "title": "%command.sidebar%"
      }
    ],
    "configuration": {
      "title": "Codex Context Lens",
      "properties": {
        "codexContextLens.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%setting.codexHome%"
        },
        "codexContextLens.refreshSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 300,
          "description": "%setting.refreshSeconds%"
        },
        "codexContextLens.maxSessions": {
          "type": "number",
          "default": 80,
          "minimum": 5,
          "maximum": 300,
          "description": "%setting.maxSessions%"
        },
        "codexContextLens.autoRefreshHover": {
          "type": "boolean",
          "default": true,
          "description": "%setting.autoRefreshHover%"
        },
        "codexContextLens.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%setting.language%",
          "enumDescriptions": [
            "%language.auto%",
            "%language.en%",
            "%language.zh%"
          ]
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "codexContextLens.live",
          "name": "%view.live%"
        }
      ]
    }
  },
  "scripts": {
    "test": "node scripts/test.cjs",
    "package:local": "node scripts/build.cjs",
    "check:package": "python scripts/check-package.py",
    "check:release": "node scripts/release-check.cjs"
  },
  "icon": "media/icon.png",
  "keywords": [
    "codex",
    "tokens",
    "context",
    "usage",
    "privacy"
  ],
  "galleryBanner": {
    "color": "#18212d",
    "theme": "dark"
  },
  "pricing": "Free",
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lamboooor/CodexContextLens.git"
  },
  "homepage": "https://github.com/Lamboooor/CodexContextLens#readme",
  "bugs": {
    "url": "https://github.com/Lamboooor/CodexContextLens/issues"
  },
  "author": "Ruoyu Li"
}
